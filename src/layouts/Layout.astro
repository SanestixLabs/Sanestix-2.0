---
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
import '../index.css';

const { title = "Sanestix - AI & Automation Solutions" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script src="https://assets.calendly.com/assets/external/widget.js" async></script>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light'; // Default to light theme always
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans relative flex flex-col overflow-x-hidden transition-colors duration-300">
    <script is:inline>
      const calendlyUrl = 'https://calendly.com/sanestix-info/sanestix-free-strategy-call?primary_color=00cdff';
      const openCalendlyPopup = () => {
        if (window.Calendly) {
          window.Calendly.initPopupWidget({ url: calendlyUrl });
          return;
        }

        const existingScript = document.querySelector('script[data-calendly-widget]');
        if (existingScript) {
          existingScript.addEventListener('load', () => window.Calendly?.initPopupWidget({ url: calendlyUrl }), { once: true });
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://assets.calendly.com/assets/external/widget.js';
        script.async = true;
        script.dataset.calendlyWidget = 'true';
        script.addEventListener('load', () => window.Calendly?.initPopupWidget({ url: calendlyUrl }), { once: true });
        document.head.appendChild(script);
      };

      document.addEventListener('click', (event) => {
        const trigger = event.target instanceof Element ? event.target.closest('[data-calendly-popup="true"]') : null;
        if (!trigger) return;
        event.preventDefault();
        openCalendlyPopup();
      });
    </script>
    <Navbar client:load />
    <main class="flex-1 flex flex-col overflow-x-hidden">
      <slot />
    </main>
    <Footer client:load />
  </body>
</html>
