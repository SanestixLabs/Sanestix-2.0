---
import Layout from '../layouts/Layout.astro';
import { Mail, MapPin, Phone } from 'lucide-react';
---

<Layout title="Contact Us | Sanestix">
  <section class="w-full pt-32 pb-20 px-6 lg:px-12 max-w-[1600px] mx-auto min-h-screen flex flex-col justify-center">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      
      <div class="flex flex-col">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-2 h-2 rounded-full bg-[#00bfff]"></div>
          <span class="text-sm font-bold text-[#00bfff] tracking-widest uppercase">GET IN TOUCH</span>
        </div>
        <h1 class="text-5xl md:text-6xl font-bold text-slate-900 dark:text-white leading-[1.1] tracking-tight mb-8">
          Let's build your AI advantage.
        </h1>
        <p class="text-xl text-slate-600 dark:text-slate-400 max-w-xl leading-relaxed mb-12">
          Ready to eliminate operational drag and scale faster? Speak directly with an automation architect today.
        </p>

        <div class="flex flex-col gap-8">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center"><Mail class="w-5 h-5 text-slate-900 dark:text-white" /></div>
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Email Us</p>
              <p class="text-lg font-bold text-slate-900 dark:text-white">hello@sanestix.com</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center"><Phone class="w-5 h-5 text-slate-900 dark:text-white" /></div>
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Call Us</p>
              <p class="text-lg font-bold text-slate-900 dark:text-white">+92 301 4422951</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center"><MapPin class="w-5 h-5 text-slate-900 dark:text-white" /></div>
            <div>
              <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Headquarters</p>
              <p class="text-lg font-bold text-slate-900 dark:text-white">Lahore, Pakistan</p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-xl shadow-slate-200/20 dark:shadow-black/20 transition-colors">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-8">Book a Discovery Call</h3>
        <form class="flex flex-col gap-6">
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">Full Name</label>
            <input type="text" class="w-full h-12 px-4 rounded-lg border border-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:placeholder-slate-500 focus:outline-none focus:border-[#00bfff] focus:ring-1 focus:ring-[#00bfff]" placeholder="John Doe" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">Work Email</label>
            <input type="email" class="w-full h-12 px-4 rounded-lg border border-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:placeholder-slate-500 focus:outline-none focus:border-[#00bfff] focus:ring-1 focus:ring-[#00bfff]" placeholder="john@company.com" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700 dark:text-slate-300">How can we help?</label>
            <textarea class="w-full p-4 rounded-lg border border-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:placeholder-slate-500 focus:outline-none focus:border-[#00bfff] focus:ring-1 focus:ring-[#00bfff] min-h-[120px]" placeholder="Tell us about your operational bottlenecks..."></textarea>
          </div>
          <button type="button" class="w-full h-12 bg-[#0a0f1c] hover:bg-black text-white dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 font-bold rounded-lg transition-colors mt-2">
            Submit Request
          </button>
        </form>
      </div>

    </div>
  </section>
</Layout>
