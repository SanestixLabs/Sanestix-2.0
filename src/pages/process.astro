---
import Layout from '../layouts/Layout.astro';
import HowItWorks from '../components/home/HowItWorks';
import BottomCTA from '../components/home/BottomCTA';
---

<Layout title="Our Process | Sanestix">
  <section class="w-full pt-32 pb-10 px-6 lg:px-12 max-w-[1600px] mx-auto flex flex-col justify-center">
    <div class="max-w-4xl">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-2 h-2 rounded-full bg-[#00bfff]"></div>
        <span class="text-sm font-bold text-[#00bfff] tracking-widest uppercase">METHODOLOGY</span>
      </div>
      <h1 class="text-5xl md:text-6xl font-bold text-slate-900 dark:text-white leading-[1.1] tracking-tight mb-8">
        How we engineer automation.
      </h1>
      <p class="text-xl text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        Our proprietary execution framework ensures rapid deployment, zero operational downtime, and guaranteed ROI for every system we build.
      </p>
    </div>
  </section>

  <HowItWorks client:load />

  <BottomCTA client:load />
</Layout>
