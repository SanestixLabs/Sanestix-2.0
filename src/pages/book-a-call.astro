---
import Layout from '../layouts/Layout.astro';

const calendlyUrl = 'https://calendly.com/sanestix-info/sanestix-free-strategy-call?primary_color=00cdff';
---

<Layout title="Book a Free Strategy Call | Sanestix">
  <section class="w-full px-6 py-16 lg:px-12 lg:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-[#00bfff]">Let's talk</p>
        <h1 class="mb-5 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white md:text-5xl">Book your free strategy call</h1>
        <p class="text-lg leading-relaxed text-slate-500 dark:text-slate-400">Choose a time that works for you and tell us about the systems you want to build.</p>
      </div>
      <div class="calendly-inline-widget min-w-[320px] overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800" data-url={calendlyUrl} style="height:700px;"></div>
    </div>
  </section>
  <script>
    const widgetUrl = 'https://assets.calendly.com/assets/external/widget.js';
    if (!document.querySelector('script[src="' + widgetUrl + '"]')) {
      const script = document.createElement('script');
      script.src = widgetUrl;
      script.async = true;
      document.head.appendChild(script);
    }
  </script>
</Layout>
