---
import Layout from '../layouts/Layout.astro';
import BottomCTA from '../components/home/BottomCTA';
---

<Layout title="Our Team | Sanestix">
  <section class="w-full pt-32 pb-20 px-6 lg:px-12 max-w-[1600px] mx-auto min-h-[50vh] flex flex-col justify-center">
    <div class="max-w-4xl">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-2 h-2 rounded-full bg-[#00bfff]"></div>
        <span class="text-sm font-bold text-[#00bfff] tracking-widest uppercase">LEADERSHIP</span>
      </div>
      <h1 class="text-5xl md:text-6xl font-bold text-slate-900 dark:text-white leading-[1.1] tracking-tight mb-8">
        Built by engineers, designed for growth.
      </h1>
      <p class="text-xl text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed mb-12">
        We are a distributed team of elite AI engineers, workflow architects, and automation specialists operating at the edge of what's possible in tech.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-10">
      <div class="group relative overflow-hidden rounded-[2rem] bg-[#0a0a0a] aspect-[3/4]">
        <img src="/team-1.jpg" alt="Saad Faisal Qureshi" class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/50 to-transparent z-10"></div>
        <div class="absolute bottom-0 left-0 p-8 z-20 w-full flex items-end justify-between">
          <div>
            <p class="text-[#00bfff] text-xs font-bold tracking-widest uppercase mb-2">FOUNDER & CEO</p>
            <h3 class="text-white font-bold text-3xl">Saad Faisal Qureshi</h3>
          </div>
          <a href="https://www.linkedin.com/in/saadfaisalqureshi" target="_blank" rel="noopener noreferrer" class="p-2 bg-white/10 rounded-full hover:bg-[#00bfff]/20 hover:text-[#00bfff] text-white transition-colors backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
        </div>
      </div>
      <div class="group relative overflow-hidden rounded-[2rem] bg-[#0a0a0a] aspect-[3/4]">
        <img src="/team-2.jpg" alt="Abdul Wahab Siddiqi" class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/50 to-transparent z-10"></div>
        <div class="absolute bottom-0 left-0 p-8 z-20 w-full flex items-end justify-between">
          <div>
            <p class="text-[#00bfff] text-xs font-bold tracking-widest uppercase mb-2">CO-FOUNDER & COO</p>
            <h3 class="text-white font-bold text-3xl">Abdul Wahab Siddiqi</h3>
          </div>
          <a href="https://www.linkedin.com/in/abdulwahabsiddiqi" target="_blank" rel="noopener noreferrer" class="p-2 bg-white/10 rounded-full hover:bg-[#00bfff]/20 hover:text-[#00bfff] text-white transition-colors backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
        </div>
      </div>
      <div class="group relative overflow-hidden rounded-[2rem] bg-[#0a0a0a] aspect-[3/4]">
        <img src="/team-3.jpg" alt="Mateen Waqar" class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/50 to-transparent z-10"></div>
        <div class="absolute bottom-0 left-0 p-8 z-20 w-full flex items-end justify-between">
          <div>
            <p class="text-[#00bfff] text-xs font-bold tracking-widest uppercase mb-2">CO-FOUNDER & CMO</p>
            <h3 class="text-white font-bold text-3xl">Mateen Waqar</h3>
          </div>
          <a href="https://www.linkedin.com/in/mateen-waqar-4a325a330" target="_blank" rel="noopener noreferrer" class="p-2 bg-white/10 rounded-full hover:bg-[#00bfff]/20 hover:text-[#00bfff] text-white transition-colors backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <BottomCTA client:load />
</Layout>
