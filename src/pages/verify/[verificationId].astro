---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { db } from '../../lib/db';
import type { Credential } from '../../types/credential';
import QRCode from 'react-qr-code';
import { CheckCircle2, XCircle, AlertCircle, Building2, Calendar, Award, ShieldCheck } from 'lucide-react';

const { verificationId } = Astro.params;
const siteUrl = Astro.url.origin;
const verifyUrl = `${siteUrl}/verify/${verificationId}`;

let credential = null;
let error = null;

if (verificationId) {
  try {
    const stmt = db.prepare('SELECT * FROM credentials WHERE id = ?');
    credential = stmt.get(verificationId) as Credential | undefined;
    
    if (credential) {
      // Increment verification count
      // In a real app we might want to deduplicate by IP/session or just count hits
      db.prepare('UPDATE credentials SET verificationCount = verificationCount + 1 WHERE id = ?').run(verificationId);
      credential.verificationCount += 1;
    } else {
      error = "Credential Not Found";
    }
  } catch (e) {
    error = "Database Error";
  }
} else {
  error = "Invalid Verification ID";
}
---

<Layout title="Verify Credential | Sanestix">
  <div class="min-h-screen bg-slate-50 flex items-center justify-center p-4">
    <div class="w-full max-w-lg bg-white rounded-3xl shadow-[0_20px_40px_rgb(0,0,0,0.08)] border border-slate-100 overflow-hidden relative">
      
      <!-- Header -->
      <div class="bg-slate-900 px-8 py-10 relative overflow-hidden flex flex-col items-center text-center">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:24px_24px]"></div>
        
        <img src="/logo.jpg" alt="Sanestix" class="h-12 w-12 object-contain rounded-xl shadow-lg relative z-10 mb-6 bg-white" />
        
        {credential && credential.status !== 'Revoked' ? (
          <>
            <div class="w-16 h-16 bg-green-500 rounded-full flex items-center justify-center relative z-10 mb-4 shadow-lg shadow-green-500/20">
              <CheckCircle2 class="w-8 h-8 text-white" />
            </div>
            <h1 class="text-2xl font-bold text-white relative z-10">Credential Verified</h1>
            <p class="text-slate-300 relative z-10 mt-2 font-medium">Official Sanestix Record</p>
          </>
        ) : credential && credential.status === 'Revoked' ? (
          <>
            <div class="w-16 h-16 bg-red-500 rounded-full flex items-center justify-center relative z-10 mb-4 shadow-lg shadow-red-500/20">
              <XCircle class="w-8 h-8 text-white" />
            </div>
            <h1 class="text-2xl font-bold text-white relative z-10">Credential Revoked</h1>
            <p class="text-red-200 relative z-10 mt-2 font-medium">This credential is no longer valid</p>
          </>
        ) : (
          <>
            <div class="w-16 h-16 bg-slate-700 rounded-full flex items-center justify-center relative z-10 mb-4">
              <AlertCircle class="w-8 h-8 text-slate-300" />
            </div>
            <h1 class="text-2xl font-bold text-white relative z-10">Not Found</h1>
            <p class="text-slate-300 relative z-10 mt-2 font-medium">Invalid or missing credential ID</p>
          </>
        )}
      </div>

      <!-- Details -->
      <div class="p-8">
        {credential ? (
          <div class="space-y-6">
            <div class="text-center border-b border-slate-100 pb-6 mb-6">
              <h2 class="text-3xl font-extrabold text-slate-900 mb-2">{credential.internName}</h2>
              <p class="text-lg font-medium text-[#00bfff]">{credential.role}</p>
            </div>

            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center shrink-0">
                  <Building2 class="w-5 h-5 text-slate-400" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Department</p>
                  <p class="text-slate-900 font-medium">{credential.department}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center shrink-0">
                  <Award class="w-5 h-5 text-slate-400" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Program</p>
                  <p class="text-slate-900 font-medium">{credential.programName}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center shrink-0">
                  <Calendar class="w-5 h-5 text-slate-400" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Duration</p>
                  <p class="text-slate-900 font-medium">{new Date(credential.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })} - {new Date(credential.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
                </div>
              </div>
            </div>

            <div class="bg-slate-50 rounded-2xl p-6 mt-8 flex flex-col items-center">
              <div class="bg-white p-3 rounded-xl shadow-sm mb-4">
                <QRCode value={verifyUrl} size={120} level="M" />
              </div>
              <p class="text-xs text-slate-400 text-center max-w-[200px]">Scan to verify this credential</p>
            </div>

            <div class="border-t border-slate-100 pt-6 mt-6">
              <div class="flex flex-col gap-2">
                <div class="flex justify-between items-center text-sm">
                  <span class="text-slate-500">Verification ID:</span>
                  <span class="font-mono font-bold text-slate-900 bg-slate-100 px-2 py-1 rounded">{credential.id}</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                  <span class="text-slate-500">Issue Date:</span>
                  <span class="font-medium text-slate-900">{new Date(credential.issueDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                  <span class="text-slate-500">Status:</span>
                  <span class={`font-bold ${credential.status === 'Active' || credential.status === 'Completed' ? 'text-green-600' : 'text-red-600'}`}>
                    {credential.status}
                  </span>
                </div>
              </div>
            </div>
            
            <div class="flex items-center justify-center gap-2 mt-8 pt-6 border-t border-slate-100 text-slate-400">
              <ShieldCheck class="w-4 h-4" />
              <span class="text-xs font-semibold uppercase tracking-wider">Verified by Sanestix</span>
            </div>
          </div>
        ) : (
          <div class="text-center py-12">
            <h2 class="text-2xl font-bold text-slate-900 mb-2">Credential Not Found</h2>
            <p class="text-slate-500 mb-8">The verification ID you provided does not exist in our records or the URL is incorrect.</p>
            <a href="/" class="inline-block bg-[#00bfff] text-white font-bold py-3 px-6 rounded-xl hover:bg-[#0099cc] transition-colors">
              Return Home
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
